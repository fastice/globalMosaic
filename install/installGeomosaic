#!/usr/bin/env bash
#
# installGeomosaic -- clone/pull the GrIMP C repositories geomosaic needs, build them,
# and install the geomosaic binary.
#
# geomosaic is the only GrIMP binary globalMosaic drives. It links five separate
# repositories (GIT64 is not one repo -- every component is its own):
#
#     mosaicSource   geoMosaic/ common/ landsatMosaic/  (the binary itself)
#     gdalIO         GDAL/GeoTIFF I/O
#     clib           byte-swapped flat-file I/O
#     cRecipes       SVD, interpolation
#     triangle       Shewchuk triangulation
#
# They must sit side by side under one root (PROGDIR), because mosaicSource's Makefile
# reaches across to $(PROGDIR)/<repo> -- see GEOMOSAICDIRS in mosaicSource/Makefile.
#
# Usage:
#     installGeomosaic [options]
#
#       --gitroot DIR    where the repos live        [$HOME/progs/GIT64]
#       --bindir DIR     where geomosaic is installed [$HOME/bin/$(uname -m)]
#       --branch NAME    force this branch for EVERY repo (default: the table below)
#       --ssh            clone over ssh instead of https
#       --jobs N         parallel make jobs           [nproc]
#       --hdf5-include D HDF5 serial headers, if not in /usr/include (no-root route)
#       --hdf5-lib SPEC  HDF5 library to link, e.g. an absolute .so path
#       --gdal-libs SPEC GDAL link flags [from gdal-config --libs, plus -lproj]
#       --no-pull        build what is on disk, do not fetch
#       --force          discard local modifications when pulling
#       --check-only     report what would happen, build nothing
#       -h, --help
#
set -euo pipefail

GITROOT="${GEOMOSAIC_GITROOT:-$HOME/progs/GIT64}"
BINDIR="${GEOMOSAIC_BINDIR:-$HOME/bin/$(uname -m)}"
FORCE_BRANCH=""
PROTO=https
JOBS="$(nproc 2>/dev/null || echo 4)"
DOPULL=1
FORCE=0
HDF5INC=""
HDF5LIB=""
GDALLIBS=""
CHECKONLY=0

# landsatSource64 is here for a HEADER, not for code geomosaic links. geomosaic links only
# landsatMosaic/xyscale.o, but the Makefile compiles the whole landsatMosaic directory, and
# every file in it (xyscale.c included) does #include "landsatSource64/Lstrack/lstrack.h".
# Without the repo present, that compile fails, xyscale.o is never produced, and the link
# then fails on a missing object -- one cause presenting as two unrelated-looking errors.
REPOS=(clib cRecipes triangle gdalIO landsatSource64 mosaicSource)

# Branch per repo. clib/cRecipes/triangle are stable on master.
#
# Note the defaults DIFFER: gdalIO uses main, everything else uses master.
#
# The arbitrary-EPSG work -- `-epsg 4326` (geographic output) and `dem none`, both of which
# globalMosaic REQUIRES -- was merged into these default branches on 2026-09-27. If a clone
# still comes up without those features, the remote has not received the merge yet; the
# capability check at the end of this script is what catches that, rather than letting a
# geomosaic that silently lacks the feature reach a 900-job run.
declare -A BRANCH=(
    [clib]=master
    [cRecipes]=master
    [triangle]=master
    [landsatSource64]=master
    [gdalIO]=main
    [mosaicSource]=master
)

die() { echo "installGeomosaic: $*" >&2; exit 1; }
note() { echo "==> $*"; }

while [ $# -gt 0 ]; do
    case "$1" in
        --gitroot)    GITROOT="$2"; shift 2 ;;
        --bindir)     BINDIR="$2"; shift 2 ;;
        --branch)     FORCE_BRANCH="$2"; shift 2 ;;
        --ssh)        PROTO=ssh; shift ;;
        --jobs)       JOBS="$2"; shift 2 ;;
        --hdf5-include) HDF5INC="$2"; shift 2 ;;
        --hdf5-lib)   HDF5LIB="$2"; shift 2 ;;
        --gdal-libs)  GDALLIBS="$2"; shift 2 ;;
        --no-pull)    DOPULL=0; shift ;;
        --force)      FORCE=1; shift ;;
        --check-only) CHECKONLY=1; shift ;;
        -h|--help)    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            die "unknown option $1 (try --help)" ;;
    esac
done

repoUrl() {
    if [ "$PROTO" = ssh ]; then echo "git@github.com:fastice/$1.git"
    else echo "https://github.com/fastice/$1.git"; fi
}
repoBranch() { [ -n "$FORCE_BRANCH" ] && echo "$FORCE_BRANCH" || echo "${BRANCH[$1]}"; }

# ---------------------------------------------------------------- prerequisites
note "checking prerequisites"
missing=""
for t in git make gcc g++; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
done
[ -n "$missing" ] && die "missing tools:$missing"

# Locate GDAL and HDF5 rather than assuming a layout. Two things vary and both have bitten:
#
#  1. gdal.h. The code does #include "gdal.h", and NOTHING in the Makefile adds an include
#     path for it on Linux. On Ian's machines it resolves only because ~/.cshrc exports
#     C_INCLUDE_PATH=/usr/include/gdal -- an invisible dependency that does not exist on a
#     fresh instance, where the build dies with "gdal.h: No such file or directory". This
#     script therefore finds the directory and exports C_INCLUDE_PATH itself.
#
#  2. The HDF5 layout is Debian-specific in the Makefile (/usr/include/hdf5/serial and
#     -lhdf5_serial). RHEL/Amazon Linux/Alpine put the header at /usr/include/hdf5.h and the
#     library at -lhdf5, so the hardcoded values fail there even with hdf5-devel installed.
findDir() {  # findDir <header> <candidate dirs...>
    local h="$1"; shift
    for d in "$@"; do [ -n "$d" ] && [ -f "$d/$h" ] && { echo "$d"; return 0; }; done
    return 1
}

GDALINC="$(findDir gdal.h /usr/include/gdal /usr/include /usr/local/include \
                   ${CONDA_PREFIX:+$CONDA_PREFIX/include} ${GDAL_INCLUDE:-})" || {
    echo "installGeomosaic: cannot find gdal.h" >&2
    echo "  looked in /usr/include/gdal, /usr/include, /usr/local/include${CONDA_PREFIX:+, \$CONDA_PREFIX/include}" >&2
    echo "  install GDAL development headers (libgdal-dev / gdal-devel), or set GDAL_INCLUDE." >&2
    exit 1
}
[ -z "$HDF5INC" ] && HDF5INC="$(findDir hdf5.h /usr/include/hdf5/serial /usr/include \
                   /usr/local/include ${CONDA_PREFIX:+$CONDA_PREFIX/include})" || true
if [ -z "$HDF5INC" ]; then
    echo "installGeomosaic: cannot find hdf5.h" >&2
    echo "  geomosaic reads float16 GCOV bands through libhdf5 directly, so this is required." >&2
    rt=$(ls /usr/lib*/libhdf5*.so.* /usr/lib/*/libhdf5*.so.* 2>/dev/null | head -1)
    if [ -n "$rt" ]; then
        echo "  The HDF5 RUNTIME is present ($rt) -- only headers are missing." >&2
        echo "  With no root, unpack just the headers and point at the existing library:" >&2
        echo "    installGeomosaic --hdf5-include <dir with hdf5.h> --hdf5-lib $rt" >&2
    else
        echo "  install HDF5 development headers (libhdf5-dev / hdf5-devel)." >&2
    fi
    exit 1
fi
# Library name follows the layout: Debian splits serial/mpi, everyone else does not.
if [ -z "$HDF5LIB" ]; then
    # Debian/Ubuntu ship only libhdf5_serial.so (serial/mpi split); everyone else ships
    # libhdf5.so. Probe each directory separately -- a single `ls` over several globs
    # returns non-zero if ANY of them misses, which silently picked the wrong name.
    HDF5LIB="-lhdf5"
    for d in /usr/lib/$(uname -m)-linux-gnu /usr/lib64 /usr/lib /usr/local/lib \
             ${CONDA_PREFIX:+$CONDA_PREFIX/lib}; do
        if ls "$d"/libhdf5_serial.so* >/dev/null 2>&1; then HDF5LIB="-lhdf5_serial"; break; fi
    done
fi
[ -f /usr/include/proj.h ] || [ -f /usr/local/include/proj.h ] || \
    [ -n "${CONDA_PREFIX:-}" -a -f "${CONDA_PREFIX:-/nonexistent}/include/proj.h" ] || \
    echo "installGeomosaic: WARNING - proj.h not found; the link may fail on -lproj" >&2

# The Makefile hardcodes a Debian-era GDAL link list:
#   -lgdal -lproj -lcurl -lsqlite3 -llzma -lpoppler -lopenjp2 -lssh2 -llcms2
# Those extras are unnecessary -- libgdal.so already carries them as NEEDED -- and on a conda
# stack they are not there as linkable .so names at all, so the link dies on -llzma/-lpoppler.
# Ask gdal-config instead, which also supplies the -L that conda needs. -lproj is added back
# explicitly because common/grimpProj.c calls proj directly, not only through GDAL's OSR.
# Verified on a system GDAL: the slim list produces a byte-identical binary.
if [ -z "$GDALLIBS" ]; then
    gc=""
    # Prefer the gdal-config belonging to the SAME prefix as the headers we found, so a conda
    # gdal-config on PATH cannot describe a system GDAL, or vice versa.
    for cand in "$(dirname "$GDALINC")/bin/gdal-config" "$(dirname "$(dirname "$GDALINC")")/bin/gdal-config"; do
        [ -x "$cand" ] && { gc="$cand"; break; }
    done
    [ -z "$gc" ] && gc="$(command -v gdal-config 2>/dev/null || true)"
    if [ -n "$gc" ]; then
        GDALLIBS="$($gc --libs) -lproj"
    else
        GDALLIBS="-lgdal -lproj"
        echo "installGeomosaic: WARNING - no gdal-config found; linking with plain -lgdal -lproj" >&2
    fi
fi

# This is the invisible dependency made explicit. Prepend, never clobber.
export C_INCLUDE_PATH="$GDALINC${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"
note "gdal libs    : $GDALLIBS"
note "gdal headers : $GDALINC  (exported as C_INCLUDE_PATH)"
note "hdf5 headers : $HDF5INC"
note "hdf5 library : $HDF5LIB"
# ---------------------------------------------------------------- clone / pull
mkdir -p "$GITROOT"
note "repository root: $GITROOT"

for r in "${REPOS[@]}"; do
    br="$(repoBranch "$r")"
    url="$(repoUrl "$r")"
    d="$GITROOT/$r"

    if [ ! -d "$d/.git" ]; then
        # Fail loudly if the branch we need is not published, rather than silently
        # falling back to the default branch and building a geomosaic without the
        # features globalMosaic depends on.
        if ! git ls-remote --heads "$url" "$br" 2>/dev/null | grep -q "refs/heads/$br$"; then
            die "branch '$br' does not exist on $url
  $r has not published that branch. Either push it, or re-run with
  --branch <name> naming a branch that is on the remote."
        fi
        [ "$CHECKONLY" = 1 ] && { echo "    $r: would CLONE $url ($br)"; continue; }
        note "cloning $r ($br)"
        git clone --branch "$br" "$url" "$d"
        continue
    fi

    cur="$(git -C "$d" rev-parse --abbrev-ref HEAD)"
    # These repos TRACK their build artifacts -- the .d dependency files and the
    # <arch>-<os>/ object directories (90 such files in mosaicSource alone). The build
    # rewrites them, so after one install every repo looks modified and a naive "do not
    # clobber local work" check would refuse to pull ever again. Count only real source as
    # dirty, and restore the artifacts before pulling: they are regenerated by the next build,
    # and leaving them modified makes git refuse the fast-forward if upstream touched them.
    artifactRe='(^|/)[A-Za-z0-9_]+-(Linux|Darwin)/|\.(d|o)$'
    allDirty="$(git -C "$d" status --porcelain --untracked-files=no | awk '{print $NF}')"
    srcDirty="$(printf '%s\n' "$allDirty" | grep -Ev "$artifactRe" | grep -c '[^[:space:]]' || true)"
    artPaths="$(printf '%s\n' "$allDirty" | grep -E "$artifactRe" || true)"
    dirty="$srcDirty"
    if [ "$CHECKONLY" = 1 ]; then
        echo "    $r: on '$cur', want '$br', $dirty modified tracked file(s)"
        continue
    fi
    if [ "$DOPULL" = 0 ]; then
        note "$r: using working tree as-is (on '$cur')"
        continue
    fi
    if [ "$dirty" -gt 0 ] && [ "$FORCE" = 0 ]; then
        # Never discard someone's work to satisfy an install.
        echo "installGeomosaic: WARNING - $r has $dirty modified SOURCE file(s) on '$cur':" >&2
        printf '%s\n' "$allDirty" | grep -Ev "$artifactRe" | sed 's/^/    /' >&2
        echo "  leaving it alone and building what is there. Use --force to reset." >&2
        continue
    fi
    note "updating $r -> $br"
    if [ -n "$artPaths" ]; then
        # discard only the tracked build artifacts, never source
        printf '%s\n' "$artPaths" | xargs -r git -C "$d" checkout --quiet -- 2>/dev/null || true
    fi
    git -C "$d" fetch --quiet origin
    if [ "$FORCE" = 1 ]; then
        git -C "$d" checkout --quiet -B "$br" "origin/$br" 2>/dev/null \
            || git -C "$d" checkout --quiet "$br"
        git -C "$d" reset --hard --quiet "origin/$br" 2>/dev/null || true
    else
        git -C "$d" checkout --quiet "$br"
        # --ff-only: never create a merge commit behind the user's back.
        git -C "$d" pull --quiet --ff-only origin "$br" || \
            echo "installGeomosaic: WARNING - $r could not fast-forward; building current HEAD" >&2
    fi
done

if [ "$CHECKONLY" = 1 ]; then
    echo
    echo "    would install to: $BINDIR/geomosaic"
    exit 0
fi

# ---------------------------------------------------------------- build
# ROOTDIR is only used to derive defaults the other two variables override, but the
# Makefile expects it, so pass all three explicitly.
mkdir -p "$BINDIR"
note "building geomosaic (-j$JOBS) into $BINDIR"
makeArgs=()
[ -n "$HDF5INC" ] && makeArgs+=("HDF5INCLUDE=$HDF5INC")
[ -n "$HDF5LIB" ] && makeArgs+=("HDF5LIB=$HDF5LIB")
[ -n "$GDALLIBS" ] && makeArgs+=("GDAL=$GDALLIBS")
make -C "$GITROOT/mosaicSource" -j"$JOBS" geomosaic \
     ROOTDIR="$(dirname "$GITROOT")" \
     PROGDIR="$GITROOT" \
     BINDIR="$BINDIR" "${makeArgs[@]}"

[ -x "$BINDIR/geomosaic" ] || die "build finished but $BINDIR/geomosaic is not there"

# ---------------------------------------------------------------- capability check
# The real guarantee. A branch name can be wrong, a merge can drop a feature, an old
# binary can be earlier on PATH -- none of which the build would complain about. This
# runs the binary we just installed and confirms it actually does the two things
# globalMosaic cannot work without: a geographic output grid, and no DEM.
note "verifying the installed binary supports -epsg 4326 and dem none"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
printf 'frequency: A\npolarization: HH\nuseMask: 1\nfiles:\n' > "$tmp/empty.yaml"
printf -- '-1.0 -1.0 0.01 0.01 0.001 0.001\n0\n' > "$tmp/tiny.in"
# geomosaic is EXPECTED to exit non-zero here: the yaml lists no granules, so it stops with
# "No range/Doppler or GCOV inputs". What is being tested is that it got far enough to accept
# `dem none` and resolve EPSG:4326 -- an older binary dies earlier, trying to open none.geodat.
# Output goes to a file rather than a pipe because `set -o pipefail` would otherwise report
# the (expected) non-zero exit as a failed check.
( cd "$tmp" && OPENBLAS_NUM_THREADS=1 "$BINDIR/geomosaic" -S1Cal -calOutput gamma0 \
      -epsg 4326 -gcov empty.yaml tiny.in none capchk ) > "$tmp/capchk.log" 2>&1 || true
if grep -q 'grid units are DEGREES' "$tmp/capchk.log"; then
    note "capability check PASSED"
else
    die "the installed geomosaic does NOT support -epsg 4326 with 'dem none'.
  It was built from branches that lack the arbitrary-EPSG work. Check the BRANCH
  table at the top of this script against what is actually published."
fi

echo
echo "geomosaic installed: $BINDIR/geomosaic"
echo
echo "Add to PATH if needed:   export PATH=\"$BINDIR:\$PATH\""
echo "Always set for runs:     export OPENBLAS_NUM_THREADS=1"
echo "  (every binary linking libgdal pulls in libopenblas, whose constructor spawns an"
echo "   idle thread pool sized to the machine before main(); no GrIMP code uses BLAS.)"
